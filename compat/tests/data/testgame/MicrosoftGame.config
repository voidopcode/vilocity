<?xml version="1.0" encoding="utf-8"?>
<!-- Fake GDK package manifest for the Vilocity test title. -->
<Game configVersion="1">
  <Identity Name="Vilocity.TestTitle" Publisher="CN=Vilocity" Version="1.0.0.0"/>
  <ExecutableList>
    <Executable Name="vilocity_testtitle.exe" TargetDeviceFamily="Scarlett" Id="Game"/>
  </ExecutableList>
  <ShellVisuals DefaultDisplayName="Vilocity Test Title" PublisherDisplayName="Vilocity"/>
  <!-- settings Vilocity takes from a title's manifest (values of a real title) -->
  <PersistentLocalStorage>
    <SizeMB>2048</SizeMB>
  </PersistentLocalStorage>
  <VirtualMachine>
    <SMTEnabled>true</SMTEnabled>
    <XboxLockhartTitleMemory>Advanced</XboxLockhartTitleMemory>
    <XboxAnacondaTitleMemory>Advanced</XboxAnacondaTitleMemory>
  </VirtualMachine>
</Game>
